# Environment Configuration for Embedding Models
# ================================================

# ===== EMBEDDING MODEL SELECTION =====
# Choose between "jina" (1024-dim) or "bge" (384-dim)
# Default: jina
EMBEDDING_MODEL=bge

# ===== DEVICE CONFIGURATION =====
# Force CPU mode (useful for low-VRAM GPUs or testing)
# Options: 0 (use GPU if available) or 1 (force CPU)
# Default: 0
FORCE_CPU=0

# ===== LIGN RE-RANKER CONFIGURATION =====
# Enable/disable LIGN re-ranking
# Options: 0 (disabled) or 1 (enabled)
# Default: 1
LIGN_ENABLED=1

# ===== DATABASE CONFIGURATION =====
MONGO_URL=mongodb://localhost:27017
DB_NAME=agri_brain_db

# ===== MODEL PATHS =====
# These are automatically resolved based on EMBEDDING_MODEL
# BGE model uses: artifacts/models/query_expander.pth
# Jina model uses: artifacts/models/deep_residual_expander.pt
